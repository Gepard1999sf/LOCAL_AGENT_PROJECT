{
  "name": "codewhale-desktop-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Mocked-IPC end-to-end UI tests for CodeWhale Desktop (Playwright, no Tauri/CodeWhale needed).",
